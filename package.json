{
  "name": "derby",
  "description": "MVC framework making it easy to write realtime, collaborative applications that run in both Node.js and browsers.",
  "version": "4.2.3",
  "homepage": "http://derbyjs.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derbyjs/derby.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components.js",
    "./dist/components": "./dist/components.js",
    "./parsing": "./dist/parsing/index.js",
    "./dist/parsing": "./dist/parsing/index.js",
    "./templates": "./dist/templates/index.js",
    "./dist/templates": "./dist/templates/index.js",
    "./App": "./dist/App.js",
    "./AppForServer": "./dist/AppForServer.js",
    "./server": "./dist/server.js",
    "./dist/server": "./dist/server.js",
    "./Page": "./dist/Page.js",
    "./test-utils": "./dist/test-utils/index.js",
    "./test-utils/*": "./dist/test-utils/*.js",
    "./dist/test-utils": "./dist/test-utils/index.js",
    "./dist/test-utils/*": "./dist/test-utils/*.js",
    "./file-utils": "./dist/files.js"
  },
  "files": [
    "dist/",
    "test-utils/"
  ],
  "scripts": {
    "build": "tsc",
    "checks": "npm run lint && npm test",
    "docs": "typedoc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "npm run build",
    "test": "mocha 'test/all/**/*.mocha.*' 'test/dom/**/*.mocha.*' 'test/server/**/*.mocha.*'"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "esprima-derby": "^0.1.0",
    "html-util": "^0.2.3",
    "qs": "^6.14.0",
    "resolve": "^1.22.14",
    "serialize-object": "^1.0.0",
    "tracks": "file:../tracks"
  },
  "peerDependencies": {
    "racer": "^2.3.1"
  },
  "bugs": {
    "url": "https://github.com/derbyjs/derby/issues"
  },
  "author": "Nate Smith",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/esprima-derby": "npm:@types/esprima@^4.0.6",
    "@types/estree": "^1.0.10",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@types/resolve": "^1.20.6",
    "@types/sharedb": "^6.0.1",
    "async": "^3.2.6",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "express": "^4.22.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "mocha": "^12.0.3",
    "racer": "file:../racer",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
